model Order {
   id              String        @id @default(uuid())
   authorId        String // better-auth
   totalAmount     Float
   totalOrder      Int
   shippingAddress String
   status          OrderStatus   @default(PLACED)
   paymentMethod   PaymentStatus @default(CASH_ON_DELIVERY)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt
}

enum OrderStatus {
   PLACED
   PROCESSING
   SHIPPED
   DELIVERED
   CANCELLED
}

enum PaymentStatus {
   CASH_ON_DELIVERY
   MOBILE_BANKING
   BANKING
}
